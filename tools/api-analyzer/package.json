{
	"name": "api-analyzer",
	"version": "0.0.0",
	"private": true,
	"description": "Experimental reusable API analysis with native TypeScript 7.",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check:format": "biome check .",
		"format": "biome check . --write",
		"check:fences": "good-fences --project tsconfig.json --rootDir src",
		"lint": "eslint . --max-warnings 0 && npm run check:fences",
		"lint:fix": "eslint . --fix --max-warnings 0",
		"test": "mocha"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@fluidframework/eslint-config-fluid": "file:../../common/build/eslint-config-fluid",
		"@types/mocha": "10.0.10",
		"@types/node": "22.19.17",
		"eslint": "~9.39.1",
		"good-fences": "0.10.0",
		"jiti": "^2.6.1",
		"mocha": "11.7.5",
		"typescript": "7.0.2",
		"typescript6": "npm:typescript@6.0.3"
	},
	"engines": {
		"node": ">=22.22.2"
	},
	"packageManager": "pnpm@11.15.1",
	"dependencies": {
		"@eslint/object-schema": "3.0.5",
		"@microsoft/tsdoc": "0.16.0",
		"zod": "^4.5.4"
	}
}
